          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation($id: String!) { create_booking(_user_id: $id, _dates: [{date: \\\"20151201\\\", movies: [\\\"267eedb8-0f5d-42d5-8f43-72426b9fb3e6\\\"]}]) { userid dates { date movies } } }\",\"variables\":{\"id\":\"{{demo_user_id}}\"}}"
            },
            "url": {
              "raw": "{{booking_url}}/graphql",
              "host": [
                "{{booking_url}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
          "name": "04 - Consulter la réservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query($id: String!) { booking_with_user_id(_user_id: $id) { userid dates { date movies } } }\",\"variables\":{\"id\":\"{{demo_user_id}}\"}}"
            },
            "url": {
              "raw": "{{booking_url}}/graphql",
              "host": [
                "{{booking_url}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
