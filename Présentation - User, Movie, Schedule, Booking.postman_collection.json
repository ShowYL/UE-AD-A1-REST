              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation($id: String!) { delete_booking(_user_id: $id) }\",\"variables\":{\"id\":\"{{demo_user_id}}\"}}"
            },
            "url": {
              "raw": "{{booking_url}}/graphql",
              "host": [
                "{{booking_url}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
